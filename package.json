{
  "name": "dianpingnote",
  "private": true,
  "description": "点评笔记助手官网源码 · VitePress + SEO/GEO 构建链",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build_demo.mjs && vitepress dev",
    "predemo": "node scripts/build_demo.mjs",
    "demo": "node scripts/build_demo.mjs",
    "check:demo": "node scripts/check_demo_coverage.mjs",
    "check:geo": "python scripts/check_geo_lint.py",
    "check:links": "node scripts/check_links.mjs",
    "check:llms": "node scripts/check_llms_txt.mjs",
    "audit:geo": "node scripts/audit_geo.mjs",
    "prebuild": "node scripts/build_demo.mjs && node scripts/check_demo_coverage.mjs && node scripts/build_seo.mjs --stage src",
    "build": "vitepress build",
    "postbuild": "node scripts/build_seo.mjs --stage dist",
    "verify": "npm run check:geo && npm run check:links && npm run check:llms && npm run audit:geo",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "esbuild": "^0.21.5"
  }
}
